# ──────────────────────────────────────────────
# MyLegalPrompt — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ──────────────────────────────────────────────

# Database (PostgreSQL in production)
DATABASE_URL="postgresql://user:password@localhost:5432/mylegalprompt?schema=public"

# Auth.js (NextAuth v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Anthropic Claude (AI analysis engine)
ANTHROPIC_API_KEY=""
# Optional self-hosted/proxy base URL; leave blank for api.anthropic.com
ANTHROPIC_BASE_URL=""
ANTHROPIC_MODEL="claude-opus-4-8"

# Stripe (payments)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Price ID for the Pro plan recurring subscription
STRIPE_PRO_PRICE_ID=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Max upload size in MB
MAX_UPLOAD_MB="15"
